%%% Artigo de periódico:
@article{Desdentado2025,
   title = {{Quantum computing software solutions, technologies, evaluation and limitations: a systematic mapping study}},
   author = {Elena Desdentado and Coral Calero and M. Ángeles Moraga and Félix García},
   journal = {Computing},
   volume = {107},
   number = {5},
   pages = {},
   artnum = {110},
   year = {2025},
   address = {Vienna},
   url = {https://link.springer.com/article/10.1007/s00607-025-01459-2},
   urlaccessdate = {2 mar. 2026},
   doi = {https://doi.org/10.1007/s00607-025-01459-2}
}
% title         = título do artigo — entre chaves duplas para preservar
% author        = autor(es)
% journal       = título do periódico
% volume        = volume do periódico — se não tiver, deixa vazio
% number        = número do periódico — se não tiver, deixa vazio
% pages         = páginas do artigo no periódico — se não tiver, deixa vazio
% artnum        = número do artigo — substitui pages se o artigo possuir apenas número/identificador eletrônico, geralmente artigos digitais, se não tiver, deixa vazio
% year          = ano de publicação
% address       = cidade de publicação — se não tiver, utiliza-se [s. l.] (sine loco): address = {[\textit{S. l.}]}
% url           = link do artigo
% urlaccessdate = data de acesso (dia, mês e ano) — mês abreviado (jan. | fev. | mar. | abr. | maio | jun. | jul. | ago. | set. | out. | nov. | dez.)
% doi           = link do DOI do artigo — geralmente "https://doi.org/" seguido do DOI
% Exemplo de referência: 
% DESDENTADO, Elena \textit{et al}. Quantum computing software solutions, technologies, evaluation and limitations: a systematic mapping study. \textbf{Computing}, Vienna, v. 107, n. 5, art. 110, 2025. DOI: https://doi.org/10.1007/s00607-025-01459-2. Disponível em: https://link.springer.com/article/10.1007/s00607-025-01459-2. Acesso em: 2 mar. 2026.


